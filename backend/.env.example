# ===========================================
# WhatsApp Business Automation - Configuration
# ===========================================

# ===================
# DJANGO SETTINGS
# ===================
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# ===================
# DATABASE (MySQL)
# ===================
MYSQL_DATABASE=whatsapp_automation
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_secure_password
MYSQL_HOST=localhost
MYSQL_PORT=3306

# ===================
# REDIS & CELERY
# ===================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===================
# JWT AUTHENTICATION
# ===================
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256

# ===================
# STRIPE PAYMENTS
# ===================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...
STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# ===================
# M-PESA (KENYAN MARKET)
# ===================
MPESA_ENVIRONMENT=sandbox  # Use 'production' for live
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_BUSINESS_SHORT_CODE=123456
MPESA_PASSKEY=your_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_SECURITY_CREDENTIAL=your_security_credential
MPESA_CALLBACK_URL=https://yourdomain.com/api/v1/billing/mpesa/callback/
MPESA_VALIDATION_URL=https://yourdomain.com/api/v1/billing/mpesa/validation/
MPESA_CONFIRMATION_URL=https://yourdomain.com/api/v1/billing/mpesa/confirmation/

# ===================
# PAYSTACK (KENYAN MARKET)
# ===================
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret

# ===================
# FRONTEND
# ===================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ===================
# SENTRY (MONITORING)
# ===================
SENTRY_DSN=

# ===================
# EMAIL (Optional)
# ===================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ===================
# WHATSAPP API (Optional)
# ===================
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_API_TOKEN=your_whatsapp_token

# ===================
# CORS
# ===================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
